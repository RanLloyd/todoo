# Copy this file to .env (same folder as app.py) and edit it.
# --- MySQL (XAMPP defaults shown: user root, no password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=attendance_monitoring
SECRET_KEY=replace-with-a-long-random-secret
# Used only the first time the database is created (admin must change it at first sign-in):
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
SCHOOL_TZ=Asia/Manila
# Set to 1 when the site is served over HTTPS
HTTPS_ONLY=0
# Local HTTPS for phone cameras (set HTTPS=0 to disable). HTTP stays on PORT, HTTPS uses HTTPS_PORT.
HTTPS=1
HTTPS_PORT=5443
# Set to 1 when an HTTPS reverse proxy (nginx, hosting panel) sits in front of the app
TRUST_PROXY=0
